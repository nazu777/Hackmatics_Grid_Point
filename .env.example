# Database Configuration (Neon Serverless Postgres)
# Replace with your actual credentials from Neon Console or CLI
DATABASE_URL=postgresql://<user>:<password>@<endpoint-pooler>.<region>.aws.neon.tech/<dbname>?sslmode=require
NEON_PROJECT_ID=<your-neon-project-id>
NEON_DATABASE=<your-database-name>

# Map basemaps (optional — app works keyless by default)
# Light/Dark default to keyless Esri grey canvases. To use CARTO positron/dark_all
# instead, request a free key at https://carto.com/basemaps/apikey and set:
# VITE_CARTO_KEY=<your-carto-basemaps-key>
# (VITE_CARTO_API_KEY is also accepted as an alias.)
