# Database Configuration (Neon Serverless Postgres)
# Replace with your actual credentials from Neon Console or CLI
DATABASE_URL=postgresql://<user>:<password>@<endpoint-pooler>.<region>.aws.neon.tech/<dbname>?sslmode=require
NEON_PROJECT_ID=<your-neon-project-id>
NEON_DATABASE=<your-database-name>

# Auth user store (JSON file backing login/signup so accounts survive restarts)
# Local default: backend/data/users.json (git-ignored). Production/Vercel
# serverless filesystems are ephemeral — set a /tmp path instead:
# via `vercel env add GRIDPOINT_USERS_FILE production` with value
# /tmp/gridpoint_users.json. Long-term path: Neon Postgres users table.
# GRIDPOINT_USERS_FILE=/tmp/gridpoint_users.json
# Workspace store (per-user warehouses/vehicles/demand/config, same rules):
# local default backend/data/user_data.json (git-ignored).
# GRIDPOINT_DATA_FILE=/tmp/gridpoint_user_data.json
# GRIDPOINT_JWT_SECRET=<long-random-secret>
# GRIDPOINT_JWT_TTL=86400

# Map basemaps — Mapbox GL JS (required even for local dev).
# Free tier covers development (~50k map loads/mo). Get a public token at:
# https://account.mapbox.com → Tokens → Create token (public scope `pk.*`).
# Then put it in frontend/.env.local and restart `pnpm dev`:
# VITE_MAPBOX_TOKEN=pk.your_token_here

# Live fuel prices (RapidAPI daily-fuel-prices-in-india-api, server-side only)
# NEVER commit a real key. Local: copy to .env (git-ignored). Production: set
# via `vercel env add RAPIDAPI_KEY production`. Without it the API serves
# static fallback rates and reports live=false.
# RAPIDAPI_KEY=<your-rapidapi-key>

# Live traffic speeds (TomTom Traffic Flow API, server-side only)
# NEVER commit a real key. Local: copy to .env (git-ignored). Production: set
# via `vercel env add TOMTOM_KEY production`. Without it the engine uses
# past corridor history + the manual traffic floor and reports live=false.
# Rolling history persists to TRAFFIC_HISTORY_PATH (default data/traffic_history.json).
# TOMTOM_KEY=<your-tomtom-key>

# US Census API (ACS 5-year tract populations, server-side only)
# NEVER commit a real key. Local: copy to .env (git-ignored). Production: set
# via `vercel env add CENSUS_KEY production`. Keyless mode works with standard
# Census quotas; the key raises them.
# CENSUS_KEY=<your-census-api-key>
